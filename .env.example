# 仅为配置示例，应用不会自动加载 .env。
# Render Blueprint 已设置这些值；手动部署请在 Environment 中填写。
APP_ENV=production
PYTHONUNBUFFERED=1
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# PORT 由 Render 注入；仅在本机模拟 Gunicorn 时按需设置。
# PORT=10000
# Python 由 .python-version 固定；已有 PYTHON_VERSION 环境变量会优先。
# python app.py 继续监听 127.0.0.1:5000，不使用这里的 Gunicorn 设置。
